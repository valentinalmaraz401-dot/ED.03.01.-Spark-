    "from pyspark.sql import SparkSession\n",
    "\n",
    "spark = SparkSession.builder.appName(\"HolaSpark\").getOrCreate()\n",
    "sc = spark.sparkContext\n",
    "\n",
    "numeros = sc.parallelize(range(101))\n",
    "print(f\"La suma de 0 a 100 es: {numeros.sum()}\")"
